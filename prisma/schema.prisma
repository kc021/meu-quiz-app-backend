generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                   String           @id @default(cuid())
  email                String           @unique
  nome                 String
  senha_hash           String
  data_criacao         DateTime         @default(now())
  cargo                Role             @default(USER)
  pontuacao            Pontuacao?
  gruposLiderados      Grupo[]          @relation("LiderDoGrupo")
  
  // --- ESTE É UM DOS CAMPOS QUE FALTAVA ---
  // A relação de volta para a tabela de junção
  gruposMembro         MembrosDoGrupo[] @relation("UsuarioMembro")

  salasDeJogoAnfitriao SalaDeJogo[]     @relation("HostDaSala")
  salaDeJogoId         String?
  salaDeJogo           SalaDeJogo?      @relation("JogadoresNaSala", fields: [salaDeJogoId], references: [id])
}

model Categoria {
  id          String       @id @default(cuid())
  nome        String       @unique
  questoes    Questao[]
  salasDeJogo SalaDeJogo[]
}

model Questao {
  id              String      @id @default(cuid())
  enunciado       String
  opcoes          String[]
  respostaCorreta Int
  tipo            TipoQuestao @default(MULTIPLA_ESCOLHA)
  categoriaId     String
  categoria       Categoria   @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
}

model Pontuacao {
  id        String  @id @default(cuid())
  pontos    Int     @default(0)
  usuarioId String  @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Grupo {
  id      String           @id @default(cuid())
  nome    String           @unique
  liderId String
  lider   Usuario          @relation("LiderDoGrupo", fields: [liderId], references: [id])
  
  // --- ESTE É O OUTRO CAMPO QUE FALTAVA ---
  // A relação de volta para a tabela de junção
  membros MembrosDoGrupo[] @relation("MembrosDoGrupo")
}

model MembrosDoGrupo {
  usuarioId String
  grupoId   String
  usuario   Usuario @relation("UsuarioMembro", fields: [usuarioId], references: [id], onDelete: Cascade)
  grupo     Grupo   @relation("MembrosDoGrupo", fields: [grupoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, grupoId])
}

model SalaDeJogo {
  id          String     @id @default(cuid())
  codigo      String     @unique
  status      StatusJogo @default(AGUARDANDO)
  hostId      String
  host        Usuario    @relation("HostDaSala", fields: [hostId], references: [id])
  jogadores   Usuario[]  @relation("JogadoresNaSala")
  categoriaId String
  categoria   Categoria  @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
}

enum StatusJogo { AGUARDANDO, EM_JOGO, FINALIZADO }
enum Role { USER, ADMIN }
enum TipoQuestao { MULTIPLA_ESCOLHA, VERDADEIRO_FALSO }